<%= javascript_include_tag 'job/index', nonce: true, type: 'module' %>
<%= render partial: "layouts/constants" %>

<div id="page-data"
     data-job-id="<%= @job_id %>"
     data-cluster="<%= @cluster %>">

  <div class="container-fluid">
    <div class="card">
      <% content_for :card_header do %>
        <span id="jobState" class="d-sm-inline-flex fs-6">
          <span class="job-state-badge badge rounded-pill me-2" 
                data-bs-toggle="tooltip" 
                data-bs-placement="bottom"
                data-job-state="unknown">
            UNKNOWN
          </span>
          <span class="d-none text-dark text-nowrap me-2">due to</span>
          <span class="d-none badge rounded-pill text-bg-light"
                data-bs-toggle="tooltip"
                data-bs-placement="bottom">
          </span>
        </span>
      <% end %>

      <%= render "shared/card_header", title: "Job: #{@job_id}", icon_classes: "fas fa-terminal text-job" %>

      <%= render "shared/loading", descriptor: "job info" %>
      <%= render "shared/error", descriptor: "job info" %>

      <!-- timeline -->
      <div class="card-body d-none">
        <div class="timeline-container mb-4">
          <div class="timeline">
            <div class="timeline-progress"></div>
          </div>
        </div>
      </div>
      <!-- tabs -->
      <div class="card-body d-none pb-0">
        <ul class="nav nav-tabs" id="myTab" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview-content" type="button" role="tab" aria-controls="overview-content" aria-selected="true">
              <i class="fas fa-info-circle"></i>
              Overview
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link d-none" id="output-tab" data-bs-toggle="tab" data-bs-target="#output-content" type="button" role="tab" aria-controls="output-content" aria-selected="false">
              <i class="fas fa-terminal"></i>
              Output
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link d-none" id="error-tab" data-bs-toggle="tab" data-bs-target="#error-content" type="button" role="tab" aria-controls="error-content" aria-selected="false">
              <i class="fas fa-exclamation-triangle"></i>
              Error
            </button>
          </li>
        </ul>
      </div>
      <!-- tabs content -->
      <div class="card-body d-none tab-content">
        <div class="tab-pane active container" id="overview-content" role="tabpanel" aria-labelledby="overview-tab" tabindex="0">
          <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4">
          </div>
        </div>
        <div class="tab-pane" id="output-content" role="tabpanel" aria-labelledby="output-tab" tabindex="0">
        </div>
        <div class="tab-pane" id="error-content" role="tabpanel" aria-labelledby="error-tab" tabindex="0"></div>
      </div>

      <!-- Cancel button -->
      <div class="card-body border-top d-none">
        <button id="cancelJobBtn" class="btn btn-outline-danger rounded-pill" aria-label="Cancel job" data-bs-toggle="modal" data-bs-target="#cancelJobModal">
          <i class="fas fa-times" aria-hidden="true"></i>
          <span class="ms-1">Cancel Job</span>
        </button>
      </div>
    </div>
  </div>


  <div class="modal" id="cancelJobModal" tabindex="-1" aria-labelledby="cancelJobModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="cancelJobModalLabel">Cancel this job?</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">Are you sure you want to cancel this job?</div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="button" id="confirmCancelJob" class="btn btn-danger">Cancel Job</button>
        </div>
      </div>
    </div>
  </div>

  <style>
   #overview-content .card-header {
     font-weight: 500;
   }

   .timeline {
     position: relative;
     display: flex;
     justify-content: space-between;
     padding-top: 1.5rem;
   }

   .timeline::before {
     content: '';
     position: absolute;
     top: 1.5rem;
     left: 0;
     right: 0;
     height: 4px;
     background-color: var(--bs-secondary-bg);
     border-radius: 50rem;
   }

   .timeline-progress {
     position: absolute;
     height: 4px;
     border-radius: 50rem;
   }

   .timeline-point {
     z-index: 3;
     width: 20%;
     text-align: center;
   }

   .timeline-point-marker {
     width: 16px;
     height: 16px;
     border: 3px solid #fff;
     border-radius: 50%;
     margin: -6px auto 0.5rem;
     transition: all 0.4s ease;
     background-color: var(--bs-secondary-bg);
     box-shadow: 0 0 0 2px var(--bs-secondary-bg);
   }

   .timeline-point.reached .timeline-point-marker {
     background-color: var(--point-color);
     box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.1);
   }

   .timeline-point.current .timeline-point-marker {
     transform: scale(1.4);
     font-size: 1.05rem;
   }

   .timeline-point-label {
     font-weight: 500;
     margin-bottom: 0.125rem;
   }

   .timeline-point.current .timeline-point-label {
     font-weight: 600;
   }
   .timeline-point.current .timeline-point-time {
     font-weight: 500;
   }
  </style>
