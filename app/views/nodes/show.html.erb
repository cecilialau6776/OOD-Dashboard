<%= javascript_include_tag 'nodes', nonce: true, type: 'module' %>
<%= render partial: "layouts/constants" %>

<div id="page-data"
     data-node-api-url="<%= url_for(controller: 'api/nodes', action: 'show',cluster: @cluster, name: @node_name) %>"
     data-node-name="<%= @node_name %>"
     data-cluster="<%= @cluster %>">

  <div class="container-fluid">
    <div class="card">
      <%= render "shared/card_header", title: "Node: #{@node_name}", icon_classes: "fas fa-microchip text-node" %>

      <%= render "shared/loading", descriptor: "node info" %>
      <%= render "shared/error", descriptor: "node info" %>

      <!-- General Info -->
      <div class="card-body d-none">
        <div class="row">
          <div class="col-md-6 col-lg-4">
            <!-- Status Card -->
            <div class="card h-100">
              <div class="card-body placeholder-wave">
                <h6 class="card-subtitle mb-3 text-muted">Status</h6>
                <h5 id="statusText" class="card-text placeholder" style="width: 50%">
                </h5>
                <p id="lastActive" class="card-text text-muted placeholder" style="width: 75%"></p>
                <span id="clusterBadge"></span>
              </div>
            </div>
          </div>
          <!-- Resources Card -->
          <div class="col-md-6 col-lg-8">
            <div class="card h-100">
              <div class="card-body">
                <h6 class="card-subtitle mb-3 text-muted">Resource Usage</h6>
                <div id="resourcesBars" class="row row-cols-2"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Running Jobs -->
      <div class="card-body d-none">
        <h4 class="card-title">Running Jobs</h4>
        <table class="table table-hover" id="jobsTable"></table>
      </div>
    </div>
  </div>
</div>


<style>
 /* mine */
 .status-box {
   width: 1rem;
   height: 1rem;
   border-radius: var(--bs-border-radius-sm);
   display: inline-block;
 }
 .status-box[data-state] {
   background-color: var(--state-color);
 }
</style>
