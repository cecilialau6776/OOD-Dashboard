<%= javascript_include_tag 'nodes', nonce: true, type: 'module' %>
<%= render partial: "layouts/constants" %>

<div id="page-data"
     data-node-api-url="<%= url_for(controller: 'api/nodes', action: 'show', name: '__NAME__') %>"
     data-node-name="<%= @node_name %>">

<div id="node-container" class="container-fluid">
  <div class="card">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
          <a href="<%= cluster_status_path %>" class="btn btn-link text-secondary p-0 me-3" aria-label="Back to cluster status">
            <i class="fas fa-arrow-left" aria-hidden="true"></i>
          </a>
          <h3 class="fw-bold mb-0">
            <i class="fas fa-microchip text-primary me-2"></i>
            Node: <span><%= @node_name %></span>
          </h3>
        </div>
        <button class="btn btn-sm btn-outline-secondary rounded-pill shadow-sm refresh-button" aria-label="Refresh node data">
          <i class="fas fa-sync-alt" aria-hidden="true"></i>
          <span class="d-none d-md-inline ms-1">Refresh</span>
        </button>
      </div>

      <div id="node_content" class="position-relative" style="min-height: 400px;">
        <div class="loading-placeholder">
          <div class="d-flex flex-column align-items-center justify-content-center h-100 py-5">
            <div class="spinner-border text-secondary" role="status" aria-label="Loading">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted mt-2">Loading node information...</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


<style>
.status-box {
  width: 16px;
  height: 16px;
  border-radius: 3px;
  display: inline-block;
}

/* Mobile-friendly styles */
.node-details-table {
  width: 100%;
}

.node-details-table th,
.node-details-table td {
  padding: 0.5rem;
  vertical-align: top;
}

.node-details-table th {
  white-space: nowrap;
  width: 140px;
}

.node-details-table td {
  word-break: break-word;
}

.node-details-table tr {
  border-bottom: 1px solid rgba(0,0,0,0.1);
}

.node-details-table tr:last-child {
  border-bottom: none;
}

@media (max-width: 768px) {
  #node-container {
    padding: 10px;
  }
  
  .card-body {
    padding: 1rem;
  }
  
  .node-details-table,
  .node-details-table tbody,
  .node-details-table tr,
  .node-details-table th,
  .node-details-table td {
    display: block;
  }
  
  .node-details-table tr {
    margin-bottom: 1rem;
  }
  
  .node-details-table tr:last-child {
    margin-bottom: 0;
  }
  
  .node-details-table th {
    padding-bottom: 0.25rem;
    color: #6c757d;
    font-size: 0.875rem;
    width: auto;
  }
  
  .node-details-table td {
    padding-top: 0.25rem;
    font-weight: 500;
  }
  
  /* Ensure status text wraps nicely on mobile */
  .status-text {
    word-break: break-word;
  }
}

/* Modern tabs styling - updated for both desktop and mobile */
.modern-tabs {
  border-bottom: 1px solid #dee2e6 !important;
  margin-bottom: 0;
  margin-top: -1rem;
  margin-left: -1rem;
  margin-right: -1rem;
  padding: 0 1rem;
}

.modern-tabs .nav-item {
  margin-bottom: -1px;
  margin-right: 1.5rem;
}

.modern-tabs .nav-link {
  border: none !important;
  color: #6c757d;
  padding: 0.75rem 0;
  font-weight: 500;
  transition: all 0.2s ease-in-out;
  position: relative;
  background: transparent !important;
}

/* Only show hover effects on desktop */
@media (min-width: 769px) {
  .modern-tabs .nav-link:hover {
    color: #495057;
  }

  .modern-tabs .nav-link:hover::after {
    background-color: rgba(0, 123, 255, 0.5);
  }
}

.modern-tabs .nav-link.active {
  color: #007bff !important;
}

.modern-tabs .nav-link::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  width: 100%;
  height: 2px;
  background-color: transparent;
  transition: all 0.2s ease-in-out;
}

.modern-tabs .nav-link.active::after {
  background-color: #007bff;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .modern-tabs {
    margin-top: -0.5rem;
    padding: 0 1rem;
  }

  .modern-tabs .nav-item {
    margin-right: 1rem;
  }
  
  .modern-tabs .nav-link {
    padding: 0.5rem 0;
    font-size: 0.875rem;
    /* Remove transition on mobile */
    transition: none;
  }

  .modern-tabs .nav-link i {
    font-size: 0.875rem;
  }
}

/* Job cards styling */
.job-card {
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 0.5rem;
  margin-bottom: 0.75rem;
}

.job-card-header {
  padding: 1rem;
  border-bottom: 1px solid #e2e8f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: white;
}

.job-card-header .job-id {
  font-weight: 500;
  color: #2b6cb0;
}

.job-card-header .job-id a {
  color: inherit;
  text-decoration: none;
}

.job-card-header .job-state {
  font-size: 0.875rem;
  color: #4a5568;
}

.job-card-body {
  padding: 1rem;
}

.job-info-row {
  display: flex;
  align-items: center;
  padding: 0.5rem 0;
  font-size: 0.875rem;
  color: #4a5568;
  border-bottom: 1px solid #f0f0f0;
  overflow: hidden;  /* Ensure content doesn't overflow */
}

.job-info-row > span {
  flex: 1;
  min-width: 0;  /* Allow text to truncate */
}

.job-info-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.job-info-row:first-child {
  padding-top: 0;
}

.time-row {
  border-bottom: none;
}

.time-info {
  background-color: #f8fafc;
  border-radius: 0.375rem;
  padding: 0.75rem;
  width: 100%;
}

.time-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
}

.time-label {
  color: #64748b;
  font-size: 0.875rem;
}

.time-value {
  color: #1a202c;
  font-weight: 500;
}

/* Badge updates */
.badge-pill {
  padding: 0.375rem 0.75rem;
  font-weight: 500;
  font-size: 0.75rem;
  border-radius: 1rem;
}

/* Icons in job info rows */
.job-info-row i {
  width: 1.25rem;
  color: #94a3b8;
  margin-right: 0.75rem;
}

/* Job name styling */
.job-name {
  font-weight: 500;
  color: #1a202c;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;  /* Ensures the truncation works */
}

/* Job ID styling */
.job-card-header .job-id a {
  color: #2563eb;
  text-decoration: none;
  font-weight: 600;
}

.job-card-header .job-id a:hover {
  color: #1d4ed8;
}

/* Empty state styling */
#jobCards .text-center {
  padding: 2rem;
  background-color: #f8fafc;
  border-radius: 0.5rem;
  color: #64748b;
}

.resource-info {
  background-color: #f8fafc;
  border-radius: 0.375rem;
  padding: 0.75rem;
  width: 100%;
}

.resource-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
}

.resource-item:first-child {
  margin-bottom: 0.25rem;
}

.resource-label {
  color: inherit;
  margin-right: 0.5rem;
  font-weight: inherit;
}

.resource-value {
  color: #1a202c;
  font-weight: 500;
}

/* Add this to your CSS */
[data-bs-toggle="tooltip"] {
  border-bottom: 1px dotted #718096;
  cursor: help;
}

/* Adjust the resource-value tooltip style to avoid double borders */
.resource-value[data-bs-toggle="tooltip"] {
  border-bottom: 1px dotted #718096;
  display: inline-block;  /* Ensures the border spans only the text width */
}

/* Remove default table cell border when it has a tooltip */
td[data-bs-toggle="tooltip"] {
  border-bottom: none;
}

td[data-bs-toggle="tooltip"] > span {
  border-bottom: 1px dotted #718096;
}

/* Add these styles */
@media (min-width: 768px) {
  .table td, 
  .table th {
    white-space: nowrap;
    max-width: 200px;  /* Prevent cells from getting too wide */
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  /* Allow job name column to wrap if needed */
  .table td:nth-child(2) {
    white-space: normal;
  }
}

.empty-state {
  padding: 2rem;
}

.empty-state-icon {
  width: 48px;
  height: 48px;
  background-color: #f1f5f9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

.empty-state-icon i {
  font-size: 1.25rem;
  color: #64748b;
}

.empty-state h5 {
  font-weight: 500;
  color: #475569;
}

.empty-state p {
  color: #64748b;
  max-width: 300px;
  margin: 0 auto;
}

/* Add these styles to your CSS section */
.job-card-header {
  cursor: pointer;
  user-select: none;
  transition: background-color 0.2s ease;
}

.job-card-header:hover {
  background-color: #f8fafc;
}

.job-card-header:active {
  background-color: #f1f5f9;
}

.job-collapse-icon {
  font-size: 0.875rem;
  color: #64748b;
  transition: transform 0.2s ease;
}

.job-collapse-icon.rotated {
  transform: rotate(180deg);
}

/* Remove the link styling from job ID in mobile view */
@media (max-width: 767.98px) {
  .job-card-header .job-id {
    color: #1a202c;
    font-weight: 500;
  }
  
  .job-card-header {
    padding: 0.875rem 1rem;
  }
  
  /* Prevent click events on the job ID to allow card expansion */
  .job-card-header .job-id {
    pointer-events: none;
  }
}

/* Remove outline from back button */
.btn-link:focus {
  box-shadow: none !important;
  outline: none !important;
}

/* Optional: Add a subtle hover effect instead */
.btn-link:hover {
  opacity: 0.75;
}

/* Only show outline on keyboard focus, not mouse clicks */
.job-card-header:focus:not(:focus-visible) {
  outline: none;
}

.job-card-header:focus-visible {
  outline: 2px solid #2563eb;
  outline-offset: -2px;
  border-radius: 0.375rem;
}

.resource-status {
  font-size: 1rem !important;  /* 16px, equivalent to ~14pt */
  font-weight: 500;
}

/* Update the resource labels and values styling */

.progress + label,
label + .progress {
  margin-top: 0.5rem;
}

label {
  font-size: 1.0625rem !important;  /* 17px */
  margin-bottom: 0.25rem;
}

/* Add spacing between progress bar and the status text */
.progress {
  margin-bottom: 0.25rem;
}

.resource-label {
  color: inherit;
  margin-right: 0.5rem;
  font-weight: inherit;
}

/* Update tooltip styling to only show dotted border for elements with actual tooltips */
[data-bs-toggle="tooltip"] .has-tooltip {
  border-bottom: 1px dotted #718096;
  cursor: help;
}

/* Remove default table cell border when it has a tooltip */
td[data-bs-toggle="tooltip"] {
  border-bottom: none;
}

td[data-bs-toggle="tooltip"] > span.has-tooltip {
  border-bottom: 1px dotted #718096;
}

/* Update resource value tooltip style */
.resource-value.has-tooltip {
  border-bottom: 1px dotted #718096;
  display: inline-block;
}

/* Add these styles to your existing CSS section */
.table tbody tr:hover {
  background-color: #f8fafc;
  transition: background-color 0.2s ease;
}

.job-card {
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.job-card:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 
              0 2px 4px -1px rgba(0, 0, 0, 0.06);
}

/* Tooltip styling */
.tooltip {
  pointer-events: none;
  z-index: 1070;
}

.tooltip-inner {
  max-width: 300px;
  padding: 0.5rem 1rem;
  text-align: left;
  background-color: #1a202c;
  font-size: 0.875rem;
  line-height: 1.4;
}

/* Ensure tooltips are clickable on mobile */
@media (max-width: 768px) {
  .tooltip {
    pointer-events: auto;
  }
}
</style> 
