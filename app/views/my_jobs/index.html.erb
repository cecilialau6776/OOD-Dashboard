<%=  javascript_include_tag 'my_jobs/index', nonce: true, type: 'module' %>
<%= render partial: "layouts/constants" %>


<div id="page-data"
     data-job-info-url="<%= url_for controller: 'job_info', action: 'json', jobid: 'JOB_ID', cluster: 'CLUSTER' %>"
     data-my-jobs-url="<%= url_for controller: 'my_jobs', action: 'json' %>">
</div>

<div class="container-fluid">
  <div class="card">
    <%= render "shared/card_header", title: "my jobs", icon_classes: "fas fa-tasks text-my-jobs" %>
    <%= render "shared/loading", descriptor: "job list" %>
    <%= render "shared/error", descriptor: "job list" %>
    <!-- state chart -->
    <div class="card-body d-none">
      <div class="row">
        <div class="col-12 col-md-4 col-lg-3">
          <div class="card border-0 bg-transparent">

            <a class="btn btn-warning fw-bold mb-2" href="<%= url_for 'performance_metrics' %>"><i class="fas fa-chart-bar"></i> Job Performance Metrics</a>
            <a class="btn btn-warning fw-bold" target="_blank" href="https://graphs.rc.rit.edu"><i class="fas fa-external-link-alt"></i> Detailed Performance Graphs</a>

            <div class="form-check form-check-inline d-none">
              <input class="form-check-input" type="checkbox" id="global-data-chart-toggle">
              <label class="form-check-label" for="global-data-chart-toggle">Use global data</label>
            </div>

            <span class="mt-2 mb-0 fw-bold">Select a date/time range:</span>
            <div id="datetime-range-selector" class="d-flex align-items-center" style="margin-top: 5px; background: transparent; cursor: pointer; padding: 5px 10px; border: 1px solid #ccc; width: 100%" aria-label="Select date and time range" aria-haspopup="dialog">
              <i class="fa fa-calendar"></i>&nbsp;&nbsp;
              <span id="datetime-range-selector-text"></span>
              <span class="ms-auto">
                <span class="visually-hidden">Toggle dropdown</span>
                <i class="fa fa-caret-down" aria-hidden="true"></i>
              </span>
            </div>
          </div>
        </div>

        <!-- chart -->
        <div class="col-12 col-md-8 col-lg-9 position-relative">
          <canvas id="chart1"></canvas>
        </div>
      </div>
    </div>
    <!-- table -->
    <div class="card-body d-none">
      <!-- Buttons -->
      <div>
        <!-- cancel -->
        <!-- reset filters -->
      </div>
      <table class="table table-sm table-hover table-responsive" id="my-jobs-table"></table>
    </div>
  </div>
</div>

<div class="modal" id="cancelJobsModal" tabindex="-1" aria-labelledby="cancelJobsModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="cancelJobsModalLabel"></h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" id="confirmCancelJobs" class="btn btn-danger">Cancel Jobs</button>
      </div>
    </div>
  </div>
</div>

