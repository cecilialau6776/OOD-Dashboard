<%# locals: (title: "default title", icon_classes: "fas fa-notdef text-error") %>

<h3 class="fw-bold card-header p-3">
  <div class="d-flex flex-column">
    <div class="d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center">
        <i class="<%= icon_classes %>"></i>
        <span class="mx-2"><%= title.titleize %></span>
      </div>
      <div class="d-flex align-items-center">
        <small id="last-updated" class="d-none d-md-block font-weight-semibold fs-6 me-3">
          Last updated: <span data-bs-toggle="tooltip" title="" style="border-bottom: 1px dotted #666;">Just now</span>
        </small>
        <button class="btn btn-sm btn-outline-secondary rounded-pill shadow-sm refresh-btn fs-6">
          <i class="fas fa-sync-alt"></i>
          <span class="d-none d-md-inline ms-1">Refresh</span>
        </button>
      </div>
    </div>
    <small id="last-updated-mobile" class="d-md-none font-weight-semibold fs-6 mt-2">
      Last updated: <span data-bs-toggle="tooltip" title="" style="border-bottom: 1px dotted #666;">Just now</span>
    </small>
  </div>
</h3>
