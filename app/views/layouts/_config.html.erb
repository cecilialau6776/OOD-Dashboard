<!-- configuration options exposed to javascript -->
<div hidden id="ood_config"
  data-max-file-size="<%= Configuration.file_upload_max %>"
  data-download-enabled="<%= Configuration.download_enabled? %>"
  data-transfers-path="<%= transfers_path(format: "json") if respond_to?(:transfers_path) %>"
  data-root-path="<%= root_path %>"
  data-uppy-locale="<%= I18n.t('dashboard.uppy', :default => {}).to_json %>"
  data-bc-dynamic-js="<%= Configuration.bc_dynamic_js? %>"
  data-xdmod-url="<%= Configuration.xdmod_host %>"
  data-base-analytics-path="<%= analytics_path('delme').gsub(/[\/]*delme[\/]*/,'') %>"
  data-bc-poll-delay="<%= Configuration.bc_sessions_poll_delay %>"
  data-bc-index-url="<%= batch_connect_sessions_path %>"
  data-status-poll-delay="<%= Configuration.status_poll_delay %>"
  data-status-index-url="<%= system_status_path if respond_to?(:system_status_path) %>"
  data-support-path="<%= support_path if respond_to?(:support_path) %>"
  data-apps-datatable-page-length="<%= @user_configuration.apps_datatable[:page_length] %>"
  data-user-home="<%= CurrentUser.home %>"
  data-jobs-info-path="<%= jobs_info_path('delme', 'delme').gsub(/[\/]*delme[\/]*/,'') %>"
  data-news-feed-url="<%= url_for controller: 'api/news_feed', action: 'get' %>"
  data-job-queue-url="<%= url_for controller: 'api/job_queue', action: 'get' %>"
  data-job-path-url="<%= job_path('JOB_ID') %>"
  data-job-api-path-url="<%= job_api_path('JOB_ID') %>"
  data-cluster-status-url="<%= url_for controller: 'api/cluster_status', action: 'get' %>"
  data-gpu-hour-summary-url="<%= url_for controller: 'api/gpu_hour_summary', action: 'get' %>"
  data-account-list-url="<%= url_for controller: 'api/account_list', action: 'get' %>"
  data-files-path="<%= files_path %>"
  data-cancel-jobs-path="<%= cancel_jobs_path %>"
  data-cancel-api-jobs-path="<%= cancel_job_api_path('JOB_ID') %>"
  data-username="<%= @user.name %>"
  data-performance-metrics-url="<%= url_for 'performance_metrics' %>"
  data-cluster-status-url="<%= url_for controller: 'api/cluster_status', action: 'get' %>"
  data-node-path-url="<%= node_path('NODE_ID') %>"
  data-performance-metrics-api-userdata-url="<%= url_for controller: 'api/performance_metrics', action: :getuserdata %>"
  data-performance-metrics-api-sacctuser-url="<%= url_for controller: 'api/performance_metrics', action: :getsacctuser %>"
></div>
