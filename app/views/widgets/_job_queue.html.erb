<%= javascript_include_tag 'job_queue', nonce: true, type: 'module' %>
<% widget_id = "job_queue" %>
<h3 class="d-flex justify-content-between align-items-center">
  <div class="d-flex align-items-center">
    <i class="fas fa-tasks text-job"></i>
    <span class="mx-2">Recent Jobs</span>
    <a class="btn btn-sm btn-outline-secondary text-nowrap d-none d-md-inline-block"
       href="<%= url_for my_jobs_path %>">
      <i class="fas fa-table me-1"></i> View All <i class="fas fa-chevron-right ms-1" style="font-size: 0.75rem;"></i>
    </a>
  </div>
  <button class="btn btn-sm btn-outline-secondary refresh-btn" data-widget="<%= widget_id %>">
    <i class="fas fa-sync-alt"></i>
  </button>
</h3>

<div class="p-2">
  <%= render "shared/loading", descriptor: "recent jobs", attributes: { 'data-widget': widget_id } %>
  <%= render "shared/error", descriptor: "recent jobs", attributes: { 'data-widget': widget_id } %>
  <!-- No recent jobs -->
  <div class="p-3 d-flex flex-column align-items-center justify-content-center h-100 none-div d-none" data-widget="<%= widget_id %>">
    <div class="text-muted mb-3">
      <i class="fas fa-tasks fa-2x"></i>
    </div>
    <h5 class="mb-2">No Recent Jobs</h5>
    <p class="text-muted mb-0">Your recent jobs will appear here once you submit them.</p>
  </div>
  <div class="card_content container" data-widget="<%= widget_id %>" style="max-height: 250px; overflow-y: auto;">
    <div class="row row-cols row-cols-lg-2 g-2"></div>
  </div>
</div>

<style>
 *[data-widget="<%= widget_id %>"] .card:hover {
  --bs-card-border-color: var(--bs-link-color);
 }
</style>
