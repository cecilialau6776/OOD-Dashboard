<%= javascript_include_tag 'job_queue', nonce: true, type: 'module' %>
<div class="d-flex flex-column h-100">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center flex-grow-1">
      <h3 class="mb-0 me-3 text-nowrap">
        <i class="fas fa-tasks text-success"></i> Recent Jobs
      </h3>
      <a class="btn btn-sm btn-outline-secondary text-nowrap d-none d-md-inline-block" 
         href="<%= url_for my_jobs_path %>">
        <i class="fas fa-table me-1"></i> View All <i class="fas fa-chevron-right ms-1" style="font-size: 0.75rem;"></i>
      </a>
    </div>
    <div class="d-flex align-items-center">
      <a class="btn btn-sm btn-outline-secondary text-nowrap d-inline-block d-md-none me-2" 
         href="<%= url_for my_jobs_path %>"
         title="View All Jobs">
        <i class="fas fa-external-link-alt"></i>
      </a>
      <button id="job_queue_refresh_button"
              class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-sync-alt"></i>
      </button>
    </div>
  </div>
  <div id="job_queue_card_content" class="flex-grow-1" style="height: 200px; overflow-y: auto;"></div>
</div>

<style>
 .btn:focus,
 .btn:active:focus,
 .btn.active:focus {
   outline: none !important;
   box-shadow: none !important;
 }

 .job-queue-card {
   transition: all 0.2s ease-in-out;
   border: 1px solid #dee2e6;
   margin-top: 2px;
   color: inherit;
 }

 .job-queue-card:hover {
   transform: translateY(-2px);
   border: 2px solid #80bdff;
   box-shadow: 0 .25rem .5rem rgba(0,0,0,.1) !important;
   text-decoration: none;
   color: inherit;
 }

 .job-queue-card:active {
   transform: translateY(0);
   border: 2px solid #0056b3;
   box-shadow: 0 .125rem .25rem rgba(0,0,0,.075) !important;
   background-color: #f8f9fa;
   text-decoration: none;
   color: inherit;
 }
</style>
