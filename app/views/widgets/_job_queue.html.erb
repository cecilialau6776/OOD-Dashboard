<%= javascript_include_tag 'job_queue', nonce: true, type: 'module' %>
<div class="d-flex flex-column h-100">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center flex-grow-1">
      <h3 class="mb-0 me-3 text-nowrap">
        <i class="fas fa-tasks text-success"></i> Recent Jobs
      </h3>
      <a class="btn btn-sm action-btn text-nowrap d-none d-md-inline-block" 
         style="background: hsl(0 0% 100%); border: 1px solid hsl(214.3 31.8% 91.4%); color: hsl(222.2 84% 4.9%); border-radius: 8px; padding: 0.375rem 0.75rem; font-weight: 500; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);"
         onmouseover="this.style.background='hsl(210 40% 98%)'; this.style.borderColor='hsl(214.3 31.8% 85%)'"
         onmouseout="this.style.background='hsl(0 0% 100%)'; this.style.borderColor='hsl(214.3 31.8% 91.4%)'"
         href="<%= url_for my_jobs_path %>">
        <i class="fas fa-table me-1"></i> View All <i class="fas fa-chevron-right ms-1" style="font-size: 0.75rem;"></i>
      </a>
    </div>
    <div class="d-flex align-items-center">
      <a class="btn btn-sm action-btn text-nowrap d-inline-block d-md-none me-2" 
         style="background: hsl(0 0% 100%); border: 1px solid hsl(214.3 31.8% 91.4%); color: hsl(222.2 84% 4.9%); border-radius: 8px; padding: 0.375rem 0.5rem; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);"
         onmouseover="this.style.background='hsl(210 40% 98%)'; this.style.borderColor='hsl(214.3 31.8% 85%)'"
         onmouseout="this.style.background='hsl(0 0% 100%)'; this.style.borderColor='hsl(214.3 31.8% 91.4%)'"
         href="<%= url_for my_jobs_path %>"
         title="View All Jobs">
        <i class="fas fa-external-link-alt"></i>
      </a>
      <button id="job_queue_refresh_button"
              class="btn btn-sm action-btn"
              style="background: hsl(0 0% 100%); border: 1px solid hsl(214.3 31.8% 91.4%); color: hsl(222.2 84% 4.9%); border-radius: 8px; padding: 0.375rem 0.5rem; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);"
              onmouseover="this.style.background='hsl(210 40% 98%)'; this.style.borderColor='hsl(214.3 31.8% 85%)'"
              onmouseout="this.style.background='hsl(0 0% 100%)'; this.style.borderColor='hsl(214.3 31.8% 91.4%)'">
        <i class="fas fa-sync-alt"></i>
      </button>
    </div>
  </div>
  <div id="job_queue_card_content" class="flex-grow-1" style="height: 200px; overflow-y: auto;"></div>
</div>

<style>
.btn:focus,
.btn:active:focus,
.btn.active:focus {
  outline: none !important;
  box-shadow: none !important;
}

.action-btn:active {
  transform: translateY(1px);
  background: hsl(210 40% 95%) !important;
  border-color: hsl(214.3 31.8% 80%) !important;
}

.job-queue-card {
    transition: all 0.2s ease-in-out;
    border: 1px solid #dee2e6;
    margin-top: 2px;
    color: inherit;
}

.job-queue-card:hover {
    transform: translateY(-2px);
    border: 2px solid #80bdff;
    box-shadow: 0 .25rem .5rem rgba(0,0,0,.1) !important;
    text-decoration: none;
    color: inherit;
}

.job-queue-card:active {
    transform: translateY(0);
    border: 2px solid #0056b3;
    box-shadow: 0 .125rem .25rem rgba(0,0,0,.075) !important;
    background-color: #f8f9fa;
    text-decoration: none;
    color: inherit;
}
</style>
