<%= javascript_include_tag 'news_feed' %>
<div class="d-flex flex-column h-100">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center flex-grow-1">
      <h3 class="mb-0 me-3 text-nowrap">
        <i class="fas fa-calendar text-warning-emphasis"></i> Upcoming Events
      </h3>
      <a href="<%= Configuration.news_feed_url %>" 
         class="btn btn-sm btn-outline-secondary text-nowrap d-none d-md-inline-block"
         target="_blank">
        <i class="far fa-calendar-alt me-1"></i> View All <i class="fas fa-chevron-right ms-1" style="font-size: 0.75rem;"></i>
      </a>
    </div>
    <div class="d-flex align-items-center">
      <a href="<%= Configuration.news_feed_url %>" 
         class="btn btn-sm btn-outline-secondary text-nowrap d-inline-block d-md-none mr-2"
         title="View All Announcements"
         target="_blank">
        <i class="fas fa-external-link-alt"></i>
      </a>
      <button onclick="loadNewsFeed()" 
              class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-sync-alt"></i>
      </button>
    </div>
  </div>
  <div id="news_feed_card_content" class="flex-grow-1" style="max-height: 250px; overflow-y: auto;"></div>
</div>
