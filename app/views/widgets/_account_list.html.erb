<%= javascript_include_tag 'account_list' %>
<h3 class="d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center">
        <i class="fas fa-layer-group text-warning"></i>
        <span class="mx-2">Projects</span>
        <a href="<%= Configuration.account_list_info_url %>" 
            class="ms-1" 
            style="color: #6c757d; font-size: 1.1rem;"
            data-bs-toggle="tooltip" 
            title="Click to see more details on ColdFront."
            aria-label="Link to ColdFront"
            target="_blank">
            <i class="fas fa-question-circle" aria-hidden="true"></i>
        </a>
    </div>
    <button onclick="load_account_list(true)" 
        class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-sync-alt"></i>
    </button>
</h3>
<div id="account_list_card_content"></div>

<style>
    .btn:focus,
    .btn:active:focus,
    .btn.active:focus {
        outline: none !important;
        box-shadow: none !important;
    }
</style>
