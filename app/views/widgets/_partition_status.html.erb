<%= javascript_include_tag 'partition_status' %>
<h3 class="d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center">
        <i class="fas fa-server text-primary"></i>
        <span class="mx-2">System Status</span>
        <a class="btn btn-sm action-btn text-nowrap d-none d-md-inline-block"
           style="background: hsl(0 0% 100%); border: 1px solid hsl(214.3 31.8% 91.4%); color: hsl(222.2 84% 4.9%); border-radius: 8px; padding: 0.375rem 0.75rem; font-weight: 500; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);"
           onmouseover="this.style.background='hsl(210 40% 98%)'; this.style.borderColor='hsl(214.3 31.8% 85%)'"
           onmouseout="this.style.background='hsl(0 0% 100%)'; this.style.borderColor='hsl(214.3 31.8% 91.4%)'"
           href="<%= url_for cluster_status_path %>">
           <i class="fas fa-table me-1"></i> View All <i class="fas fa-chevron-right ms-1" style="font-size: 0.75rem;"></i>
        </a>
    </div>
    <button onclick="load_cluster_status(true)" 
            class="btn btn-sm action-btn"
            style="background: hsl(0 0% 100%); border: 1px solid hsl(214.3 31.8% 91.4%); color: hsl(222.2 84% 4.9%); border-radius: 8px; padding: 0.375rem 0.5rem; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);"
            onmouseover="this.style.background='hsl(210 40% 98%)'; this.style.borderColor='hsl(214.3 31.8% 85%)'"
            onmouseout="this.style.background='hsl(0 0% 100%)'; this.style.borderColor='hsl(214.3 31.8% 91.4%)'">
        <i class="fas fa-sync-alt"></i>
    </button>
</h3>
<div id="cluster_status_card_content"></div>

<style>
  .btn:focus,
  .btn:active:focus,
  .btn.active:focus {
    outline: none !important;
    box-shadow: none !important;
  }

  .action-btn:active {
    transform: translateY(1px);
    background: hsl(210 40% 95%) !important;
    border-color: hsl(214.3 31.8% 80%) !important;
  }
</style>
