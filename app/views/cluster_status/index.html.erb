<%=  javascript_include_tag 'cluster_status/index', type: "module" %>


<div id="page-data"
     data-node-show-url="<%= url_for(controller: 'nodes', action: 'show', cluster: 'CLUSTER', name: 'NAME') %>"
</div>

<div class="container-fluid">
  <div class="card">
    <%= render "shared/card_header", title: "Cluster Status", icon_classes: "fas fa-server text-cluster-status" %>

    <%= render "shared/loading", descriptor: "cluster status" %>
    <%= render "shared/error", descriptor: "cluster status" %>
    
    <!-- grid/list view select -->
    <ul id="grid-list-tabs" class="nav nav-underline nav-justified mt-1 gap-0 d-none">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="heatmap-tab" data-bs-toggle="tab" data-bs-target="#heatmap-pane" type="button" role="tab" aria-controls="heatmap-pane" aria-selected="true">
          <i class="fas fa-th"></i>
          Grid
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="list-tab" data-bs-toggle="tab" data-bs-target="#list-pane" type="button" role="tab" aria-controls="list-pane" aria-selected="true">

          <i class="fas fa-list"></i>
          List
        </button>
      </li>
    </ul>

    <div class="tab-content">
      <!-- Heatmap Pane -->
      <div id="heatmap-pane" class="card-body tab-pane active d-none" role="tabpanel">
        <!-- Cluster Filter -->
        <h5 class="card-title">Cluster Filter:</h5>
        <div class="filter-group" data-filter-name="cluster">
          <button class="btn filter-toggle" type="button" data-bs-toggle="button" data-cluster="sporc">
            <div class="filter-indicator-box"></div>
            SPORC
          </button>
          <button class="btn filter-toggle" type="button" data-bs-toggle="button" data-cluster="tigris">
            <div class="filter-indicator-box"></div>
            TIGRIS
          </button>
        </div>

        <!-- Node State Filter -->
        <h5 class="card-title">Node State Filter:</h5>
        <div class="filter-group" data-filter-name="state">
          <button class="btn filter-toggle" type="button" data-bs-toggle="button" data-state="online">
            <div class="filter-indicator-box"></div>
            Online (In Use)
          </button>
          <button class="btn filter-toggle" type="button" data-bs-toggle="button" data-state="idle">
            <div class="filter-indicator-box"></div>
            Online (Idle)
          </button>
          <button class="btn filter-toggle" type="button" data-bs-toggle="button" data-state="drained">
            <div class="filter-indicator-box"></div>
            Drained
          </button>
          <button class="btn filter-toggle" type="button" data-bs-toggle="button" data-state="maintenance">
            <div class="filter-indicator-box"></div>
            Maintenance
          </button>
          <button class="btn filter-toggle" type="button" data-bs-toggle="button" data-state="down">
            <div class="filter-indicator-box"></div>
            Down
          </button>
        </div>

        <!-- Node Group Filter -->
        <h5 class="card-title">Node Group Filter:</h5>
        <div class="filter-group" data-filter-name="group" style="--bs-btn-active-"></div>

        <hr />

        <!-- Heatmap Content -->
        <div id="heatmap-container" class="node-groups-container">
        </div>
      </div>

      <!-- List Pane -->
      <div id="list-pane" class="card-body tab-pane d-none" role="tabpanel">
        <table id="node-list" class="table table-striped"></table>
      </div>
    </div>

  </div>
</div>

<style>
 /* Filter Toggles */
 .filter-toggle {
   display: flex;
   align-items: center;
   gap: .25rem;
   --bs-btn-hover-border-color: var(--bs-seconary);
   --bs-btn-active-bg: var(--bs-gray-200);
   --bs-btn-border-color: var(--bs-light-border-subtle);
 }

 .filter-indicator-box {
   width: 1rem;
   height: 1rem;
   border-radius: var(--bs-border-radius-sm);
   display: inline-block;
 }

 .filter-group {
   display: flex;
   flex-wrap: wrap;
   gap: 1rem;
   margin-bottom: 1rem;
 }

 /* Node Cells */
 .node-cell-col {
   display: flex;
   position: relative;
 }
 .node-cell.btn {
   height: 3rem;
   font-weight: 500;
   align-content: center;
   border-left: 0;
   border-top-left-radius: 0;
   border-bottom-left-radius: 0;
   --bs-btn-color: var(--bs-gray-dark);
   --bs-btn-hover-color: var(--bs-black);
 }

 .indicator-container {
   display: flex;
   flex-direction: column;
 }
 .indicator-container > div {
   flex-grow: 1;
   padding: .5em;
 }

 .indicator-container > div:first-child {
   border-top-left-radius: var(--bs-border-radius);
 }
 .indicator-container > div:last-child {
   border-bottom-left-radius: var(--bs-border-radius);
 }

 /* Colors */
 .filter-toggle[data-cluster] > .filter-indicator-box,
 .cluster-indicator {
   background-color: var(--cluster-color);
 }
 .filter-toggle[data-state] > .filter-indicator-box,
 .state-indicator {
   background-color: var(--state-color);
 }

 .filter-toggle[data-cluster] {
   --bs-btn-active-border-color: var(--cluster-color);
 }
 .filter-toggle[data-state] {
   --bs-btn-active-border-color: var(--state-color);
 }

 .node-cell-col > .node-cell.btn {
   --bs-btn-border-color: var(--state-color);
   --bs-btn-hover-bg: var(--bs-state-color);
   --bs-btn-hover-border-color: var(--bs-state-color);
 }

 .progress {
   --bs-progress-height: .5rem;
   --bs-progress-bar-bg: var(--bs-green-500);
 }
 .progress-text {
   color: var(--bs-gray-700);
 }

 /* Ensure content doesn't wrap in cells */
 .table td {
   white-space: nowrap;
   overflow: hidden;
   text-overflow: ellipsis;
 }
</style>

